#!/bin/bash
source ../settings/scripts/_common.sh

ynh_script_progression --message="Stopping the service..." --weight=2
ynh_systemctl --service="$app" --action=stop
ynh_systemctl --service="$app" --action=disable

# The encryption key is deliberately kept. Without it the encrypted PDFs in old backups
# cannot be read, so removing the key is a separate decision for the administrator.
ynh_script_progression --message="Removed. The encryption key at $key_file was kept." --last
